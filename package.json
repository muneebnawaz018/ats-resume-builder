{
  "name": "ats-resume-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "task": "vite-node --config vitest.config.ts scripts/tasks.ts",
    "predev": "npm run task prep",
    "dev": "next dev",
    "prebuild": "npm run task prep",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run task boundaries && npm run lint:md && npm run knip && npm run test",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#out\" \"#testing\"",
    "analyze": "ANALYZE=true next build --webpack",
    "knip": "knip",
    "icons": "npm run task icons",
    "fixtures": "npm run task fixtures",
    "pretest": "npm run fixtures",
    "test": "vitest run",
    "formula": "npm run task formula"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/material-nextjs": "^9.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "immer": "^11.1.15",
    "next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stemmer": "^2.0.1",
    "stopword": "^3.1.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stopword": "^2.0.3",
    "knip": "^6.29.0",
    "markdownlint-cli2": "^0.23.2",
    "sharp": "^0.35.3",
    "sonda": "^0.14.0",
    "typescript": "^5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
