# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build output
/out/

/* generated */
src/app/tokens.generated.css

# Bundle analysis reports — regenerate with `npm run analyze`.
.sonda/

# Sample documents — regenerate with `npm run fixtures`. Committing them would
# put binaries in review diffs, and a Windows checkout with autocrlf on would
# rewrite the text ones and break the tests that assert their line endings.
/testing/

# pdf.js worker — copied from node_modules by prebuild so its version cannot
# drift from the library.
/public/pdf.worker.min.mjs
